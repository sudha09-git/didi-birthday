# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pooja_birthday
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/pooja_birthday

ADMIN_USERNAME=sudha
ADMIN_PASSWORD=changeme_secure_password_here
ADMIN_SECRET_KEY=supersecretjwtkeychangeme_atleast32chars

APP_ENV=development
SECRET_KEY=anothersupersecretkeyforjwt_atleast32chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Test mode — set to true to bypass date checks during development
# In test mode, game starts at TEST_GAME_START_TIME (set this to ~2 minutes from now)
# Birthday unlocks 3 hours after game_start in test mode (6 levels × 30 min)
GAME_TEST_MODE=false
# e.g. set this to current time + 1 minute to test immediately
TEST_GAME_START_TIME=2026-10-05T15:30:00Z
